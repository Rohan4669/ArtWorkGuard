# Copy to backend/.env  (cp .env.example backend/.env). Never commit the real file.

# --- Server ---
NODE_ENV=development
APP_NAME=ArtworkGuard
PORT=4000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API (CORS allow-list).
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/artworkguard

# --- Authentication ---
# REQUIRED in production, at least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset in development an ephemeral secret is generated (sessions reset on restart).
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Defaults to true when NODE_ENV=production (requires HTTPS).
COOKIE_SECURE=
# false = only an admin-created/bootstrap account can sign in
ALLOW_REGISTRATION=true
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Storage (keep OUTSIDE any web-served directory) ---
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
PAGE_IMAGE_DIR=./storage/pages
TEMP_DIR=./storage/tmp
MAX_UPLOAD_MB=50
MAX_PAGES=100
# 0 = keep forever. N>0 = delete comparisons, reports and unused uploads older than N days (checked daily).
RETENTION_DAYS=0

# --- Comparison engine ---
COMPARISON_ENGINE=native-pdfjs-opencv
# macOS/Linux default: ../engine/.venv/bin/python   Windows: ..\engine\.venv\Scripts\python.exe
PYTHON_BIN=../engine/.venv/bin/python
COMPARISON_TIMEOUT_MS=180000
VISUAL_DPI=150
VISUAL_TARGET_PX=4000
VISUAL_MAX_PIXELS=20000000
# standard | high  (high also reports faint colour shifts, with more noise)
VISUAL_SENSITIVITY=standard

# --- Job processing ---
JOB_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
